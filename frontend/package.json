  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.55.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
